# انسخ هذا الملف إلى .env واملأ قيمك، ثم لا ترفعه أبدًا لأي مكان عام (GitHub مثلاً)
# chmod 600 .env  بعد التعبئة — عشان يقرأه بس صاحب الملف

# ══════════════════════════════════════════════════════════════════
#  التشغيل الأساسي
# ══════════════════════════════════════════════════════════════════

# وضع التشغيل: SIGNAL_ONLY (تحليل وتعلّم بدون تنفيذ) | PAPER (تجريبي) | LIVE (حقيقي)
EXECUTION_MODE=SIGNAL_ONLY

# الأسهم اللي تتابعها، مفصولة بفاصلة بدون مسافات
WATCHLIST=AAPL,MSFT,NVDA

# نسبة المخاطرة لكل صفقة (0.01 = 1%). طبقة التعلّم تقدر تنزّلها ولا ترفعها أبدًا.
RISK_PCT=0.01

# سقف عدد الصفقات المفتوحة بنفس الوقت (حماية على مستوى المحفظة كاملة)
MAX_CONCURRENT_POSITIONS=3

# الاستراتيجية: trend_follow | base_track | liquidity_sweep | auto
# auto = يختارها Thompson Sampling حسب الأداء الفعلي المتراكم
STRATEGY_NAME=trend_follow

# ══════════════════════════════════════════════════════════════════
#  مصدر البيانات
# ══════════════════════════════════════════════════════════════════

# twelvedata (موصى به، يحتاج مفتاح) | yahoo (مجاني بلا مفتاح) | csv (ملفات محلية)
DATA_PROVIDER=twelvedata
TWELVEDATA_API_KEY=

# عدد الطلبات المسموحة بالدقيقة — 8 هو حد الباقة المجانية
TWELVEDATA_RATE_LIMIT=8
# مدة صلاحية البيانات المخزّنة بالساعات (0 = بلا تخزين). يقلّل استهلاك رصيدك بشدة.
TWELVEDATA_CACHE_HOURS=12

# مطلوب فقط مع DATA_PROVIDER=csv
# DATA_CSV_DIR=./csv_data

# ══════════════════════════════════════════════════════════════════
#  الوسيط (مطلوب فقط إذا EXECUTION_MODE=PAPER أو LIVE)
# ══════════════════════════════════════════════════════════════════

# alpaca (يدعم حسابًا تجريبيًا وأوامر Bracket) | webull (حقيقي فقط، بلا Bracket)
BROKER=alpaca

ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Webull — اقرأ brokers/webull.py قبل تفعيلها: ما فيه حساب تجريبي إطلاقًا
# WEBULL_APP_KEY=
# WEBULL_APP_SECRET=
# WEBULL_ACCOUNT_ID=
# WEBULL_REGION=us
# WEBULL_CONFIRM_LIVE=no     # لازم yes صراحةً قبل أول أمر حقيقي

# ══════════════════════════════════════════════════════════════════
#  طبقة التعلّم
# ══════════════════════════════════════════════════════════════════

# يسجّل الدروس ويتعلّم منها. آمن تخليه true من اليوم الأول — بعتبة 0
# ما يرفض أي صفقة، يكتفي بالتعلّم وضبط الأحجام.
ENABLE_LEARNING=true

# عتبة رفض الإشارات الضعيفة. 0.0 = لا فلترة.
# لا ترفعها من راسك — خذ الرقم من جدول العتبات اللي يطبعه train_model.py
LEARNING_THRESHOLD=0.0

# أقل عدد صفقات قبل ما يُسمح للنموذج بالتأثير على القرارات
LEARNING_MIN_SAMPLES=40

# جزء Kelly المستخدم بحساب الحجم. 0.25 = ربع Kelly (متحفّظ ومناسب).
KELLY_FRACTION=0.25

# أقصى مدة احتفاظ بصفقة قبل ما نعتبرها منتهية لغرض التعلّم
MAX_HOLD_DAYS=60

# LEARNING_MODEL_PATH=models/model.json
# LEARNING_BANDIT_PATH=models/bandit.json

# ══════════════════════════════════════════════════════════════════
#  تنبيهات وتقارير (اختيارية)
# ══════════════════════════════════════════════════════════════════

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

ANTHROPIC_API_KEY=
ENABLE_CLAUDE_REVIEW=false
