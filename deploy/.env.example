# انسخ هذا الملف إلى .env واملأ قيمك، ثم لا ترفعه أبدًا لأي مكان عام (GitHub مثلاً)
# chmod 600 .env  بعد التعبئة — عشان يقرأه بس صاحب الملف

# وضع التشغيل: SIGNAL_ONLY (تحليل بدون تنفيذ) | PAPER (تجريبي) | LIVE (فلوس حقيقية)
EXECUTION_MODE=SIGNAL_ONLY

# الأسهم اللي تتابعها، مفصولة بفاصلة بدون مسافات
WATCHLIST=AAPL,MSFT,NVDA

# نسبة المخاطرة لكل صفقة (0.01 = 1%)
RISK_PCT=0.01

# مطلوبة فقط إذا EXECUTION_MODE=PAPER أو LIVE
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# اختياري - تنبيهات تيليجرام
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# اختياري - تحليل Claude التلقائي اليومي
ANTHROPIC_API_KEY=
ENABLE_CLAUDE_REVIEW=false
